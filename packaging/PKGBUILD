# Maintainer: Satvik Porwal <satvik.porwal14@gmail.com>
pkgname=kreoctl
pkgver=0.1.0
pkgrel=1
pkgdesc="Userspace Linux hardware controller and CLI for the Kreo Hive RGB keyboard written in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/myaumyauverse/kreoctl"
license=('MIT')
makedepends=('cargo')
depends=('gcc-libs')
optdepends=(
    'libxkbcommon: for graphical user interface'
    'wayland: for Wayland graphical session'
    'libx11: for X11 graphical session'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked --features gui
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --release --locked --features gui
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/kreoctl" "$pkgdir/usr/bin/kreoctl"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "udev/99-kreoctl.rules" "$pkgdir/usr/lib/udev/rules.d/99-kreoctl.rules"
    install -Dm644 "systemd/kreoctl-restore.service" "$pkgdir/usr/lib/systemd/user/kreoctl-restore.service"
    install -Dm644 "extra/kreoctl.desktop" "$pkgdir/usr/share/applications/kreoctl.desktop"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
